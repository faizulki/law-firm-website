# Shared secret that authenticates the Soro SEO webhook.
# Generate one with: openssl rand -hex 32
# Then give Soro this URL: https://<your-domain>/api/webhooks/soro/<value below>
SORO_WEBHOOK_TOKEN=replace-with-a-long-random-string

# Password for the site owner to log into /admin and edit site content.
# Pick a strong, unique password (not reused elsewhere).
ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP credentials for sending booking confirmation emails (one.com, in
# this case). SMTP_FROM and BOOKING_NOTIFY_EMAIL default to SMTP_USER if
# left unset. If SMTP_HOST/SMTP_USER/SMTP_PASSWORD aren't all set, booking
# emails are silently skipped (the booking itself still succeeds).
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=kontakt@invictuslaw.se
SMTP_PASSWORD=replace-with-the-mailbox-password
SMTP_FROM=kontakt@invictuslaw.se
BOOKING_NOTIFY_EMAIL=kontakt@invictuslaw.se
